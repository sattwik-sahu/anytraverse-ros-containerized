# Copy to .env and fill in your addresses.
# Robot config template every robot follows (nav2_params.yaml,
# anytraverse.yaml, pipelines/). The compose file mounts the needed files
# from this dir into each container — no rebuilds to change config.
CONFIG_DIR=config/hound
# Switch LAN (wired, Jetson <-> controller <-> Ouster)
JETSON_SWITCH_IP=192.168.10.1
OUSTER_IP=192.168.10.20
CONTROLLER_IP=192.168.10.30
# WiFi / field router side (Jetson <-> base station). Set after the Jetson
# joins the field WiFi, or use a DHCP reservation on the router.
JETSON_WIFI_IP=192.168.1.50
BASE_STATION_IP=192.168.1.100
# FLIR camera serial (see camera_lidar.launch.py default '20531756')
FLIR_SERIAL=20531756
# Offline guard: 1 = cache-only field mode (default, no WiFi),
# 0 = allow model downloads (lab seeding run on internet). With =1 a missing
# model fails loudly at startup instead of hanging on network.
OFFLINE=1
# AnyTraverse initial prompt for the pipeline (required launch arg).
# Syntax: "<prompt1>: <weight1>; <prompt2>: <weight2>[;] ..."
INIT_PROMPT=""
ROS_DOMAIN_ID=0
