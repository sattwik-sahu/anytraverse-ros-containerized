[submodule "src/perception/anytraverse_ros"]
	path = src/perception/anytraverse_ros
	url = https://github.com/sattwik-sahu/anytraverse_ros.git
	branch = main
[submodule "src/navigation/semantic_segmentation_layer"]
	path = src/navigation/semantic_segmentation_layer
	url = https://github.com/karthiknambiar29/semantic_segmentation_layer.git
	branch = humble
[submodule "src/sensors/image_pipeline"]
	path = src/sensors/image_pipeline
	url = https://github.com/ros-perception/image_pipeline.git
	branch = jazzy
[submodule "src/sensors/ouster_ros"]
	path = src/sensors/ouster_ros
	url = https://github.com/ouster-lidar/ouster-ros.git
	branch = ros2
[submodule "src/sensors/flir_camera_driver"]
	path = src/sensors/flir_camera_driver
	url = https://github.com/ros-drivers/flir_camera_driver.git
	branch = ros2-release
